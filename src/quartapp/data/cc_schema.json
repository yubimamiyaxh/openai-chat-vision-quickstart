{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Virtual Credit Card",
  "type": "object",
  "properties": {
    "Payer Name": {
      "type": "string"
    },
    "Receiver Name": {
      "type": "string"
    },
    "Monetary card value": {
      "type": "number"
    },
    "Credit card number": {
      "type": "number"
    },
    "CVV code": {
      "type": "integer"
    },
    "Expiration date": {
      "type": "string"
    },
    "Page Number": {
      "type": "integer"
    }
},
  "required": ["Payer Name", "Receiver Name", "Monetary card value", "Credit card number", "CVV code", "Expiration date", "Page Number"]
}